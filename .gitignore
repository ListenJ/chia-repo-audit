# Python
__pycache__/
*.py[cod]
.venv/

# Editor / OS
.DS_Store
*.swp

# Local credentials
.env
.env.*
application_default_credentials.json
service-account*.json
*credentials*.json

# CHIA build output (real ChampSim binaries are not checked in)
chia_loop/sim/champsim-build/
*.champsimtrace.xz

# results/ is part of the hackathon artifact, so it is intentionally tracked.

# Paper build intermediates
paper/*.aux
paper/*.log
paper/*.out

# paper_text.txt is deliberately NOT ignored: it is the searchable plain-text render the
# claim verifier gates against, so `paper/*.txt` used to swallow it (and would hand a
# fresh clone a repository whose own gate cannot run).
